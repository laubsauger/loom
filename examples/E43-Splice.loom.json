      "splice": {
        "definitionVersion": 1,
        "id": "splice",
        "label": "splice1",
        "parameters": {
          "amount": {
            "bindings": {
              "driven": {
                "channel": "gd1:high",
                "kind": "driven"
              },
              "static": {
                "kind": "static",
