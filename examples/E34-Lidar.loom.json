      "ricochet": {
        "definitionVersion": 1,
        "id": "ricochet",
        "label": "ricochet1",
        "parameters": {
          "attributes": "[{\"name\":\"position\",\"type\":\"vec3f\",\"semantic\":\"position\",\"default\":[0,0,0]},{\"name\":\"direction\",\"type\":\"vec3f\",\"default\":[0,-1,0]},{\"name\":\"hitPosition\",\"type\":\"vec3f\",\"default\":[0,0,0]},{\"name\":\"hitNormal\",\"type\":\"vec3f\",\"default\":[0,1,0]}]",
          "capacity": 240,
          "kernel": "fn process(p: Point, ctx: PointCtx) -> Point {\n  var q = p;\n  let slant = length(p.hitPosition - vec3f(0.0, 3.3, 0.0));\n  let landed = slant < 3.4 - 0.01;\n  q.position = select(vec3f(0.0, -80.0, 0.0), p.hitPosition + p.hitNormal * 0.03, landed);\n  q.direction = normalize(reflect(p.direction, p.hitNormal) + vec3f(0.0, 0.0001, 0.0));\n  return q;\n}"
