      "raise": {
        "definitionVersion": 1,
        "id": "raise",
        "label": "raise1",
        "parameters": {
          "attributes": "[{\"name\":\"position\",\"type\":\"vec3f\",\"semantic\":\"position\",\"default\":[0,0,0]},{\"name\":\"sample\",\"type\":\"vec4f\",\"default\":[0,0,0,0]}]",
          "capacity": 36864,
          "kernel": "fn process(p: Point, ctx: PointCtx) -> Point {\n  var q = p;\n  let u = f32(ctx.dim.i) / f32(ctx.dim.cols - 1u);\n  let v = f32(ctx.dim.j) / f32(ctx.dim.rows - 1u);\n  let worldX = (u * 2.0 - 1.0) * 4.8;\n  let worldZ = (v * 2.0 - 1.0) * 4.8;\n  q.position = vec3f(worldX, p.sample.r * 2.6 + (-0.6), worldZ);\n  return q;\n}"
        },
