      "mark": {
        "definitionVersion": 1,
        "id": "mark",
        "label": "mark1",
        "parameters": {
          "attributes": "[{\"name\":\"position\",\"type\":\"vec3f\",\"semantic\":\"position\",\"default\":[0,0,0]},{\"name\":\"tint\",\"type\":\"vec4f\",\"semantic\":\"color\",\"qualifier\":\"color\",\"default\":[1,1,1,1]},{\"name\":\"hit\",\"type\":\"f32\",\"default\":[0]},{\"name\":\"hitPosition\",\"type\":\"vec3f\",\"default\":[0,0,0]}]",
          "capacity": 240,
          "kernel": "fn process(p: Point, ctx: PointCtx) -> Point {\n  var q = p;\n  q.position = p.hitPosition;\n  /* distance re-derived from the one mast — see the attribute comment on why. */\n  let slant = length(p.hitPosition - vec3f(0.0, 3.3, 0.0));\n  let near = clamp(1.0 - slant / 3.4, 0.0, 1.0);\n  let ret = vec4f(1.0, 0.60 + 0.30 * near, 0.16, 1.0) * (0.5 + 1.6 * near);\n  let lost = vec4f(0.16, 0.30, 0.52, 1.0) * 0.32;\n  q.tint = mix(lost, ret, p.hit);\n  return q;\n}"
        },
        "position": {
          "x": -1600,
          "y": 40
        },
        "type": "pointKernel"
      },
      "mark2": {
        "definitionVersion": 1,
        "id": "mark2",
        "label": "mark2a",
        "parameters": {
          "attributes": "[{\"name\":\"position\",\"type\":\"vec3f\",\"semantic\":\"position\",\"default\":[0,0,0]},{\"name\":\"tint\",\"type\":\"vec4f\",\"semantic\":\"color\",\"qualifier\":\"color\",\"default\":[1,1,1,1]},{\"name\":\"hit\",\"type\":\"f32\",\"default\":[0]},{\"name\":\"hitPosition\",\"type\":\"vec3f\",\"default\":[0,0,0]}]",
          "capacity": 240,
          "kernel": "fn process(p: Point, ctx: PointCtx) -> Point {\n  var q = p;\n  q.position = p.hitPosition;\n  /* round-trip attenuation, crudely: mast → surface → echo, against 1.8× range. */\n  let path = length(p.hitPosition - vec3f(0.0, 3.3, 0.0));\n  let near = clamp(1.0 - path / (3.4 * 1.8), 0.0, 1.0);\n  q.tint = vec4f(0.30, 0.95, 0.85, 1.0) * (0.35 + 1.10 * near);\n  return q;\n}"
        },
        "position": {
          "x": -960,
          "y": 520
        },
        "type": "pointKernel"
