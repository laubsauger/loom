      "aim": {
        "definitionVersion": 1,
        "id": "aim",
        "label": "aim1",
        "parameters": {
          "attributes": "[{\"name\":\"position\",\"type\":\"vec3f\",\"semantic\":\"position\",\"default\":[0,0,0]},{\"name\":\"direction\",\"type\":\"vec3f\",\"default\":[0,-1,0]}]",
          "capacity": 240,
          "kernel": "fn process(p: Point, ctx: PointCtx) -> Point {\n  var q = p;\n  let azimuth = (f32(ctx.index) / f32(ctx.count)) * 6.28318530718 + ctx.absTime * 0.22;\n  /* 0.60..1.10 rad (34°..63° below horizontal): the steep end lands well inside range,\n     the shallow end's slant exceeds it and the outer ring goes dark — and shallow\n     strikes reflect FORWARD off back-slopes, which is where the echoes come from. */\n  let tilt = 0.60 + ctx.value1 * 0.50;\n  q.position = vec3f(0.0, 3.3, 0.0);\n  q.direction = normalize(vec3f(\n    sin(azimuth) * cos(tilt),\n    -sin(tilt),\n    cos(azimuth) * cos(tilt),\n  ));\n  return q;\n}",
          "value1": {
            "bindings": {
              "driven": {
                "channel": "tiltwave1",
                "kind": "driven"
              },
              "static": {
                "kind": "static",
                "value": 0.5
              }
            },
            "mode": "driven"
          }
        },
        "position": {
          "x": -2240,
          "y": 40
        },
        "type": "pointKernel"
