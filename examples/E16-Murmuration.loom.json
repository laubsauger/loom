      "part": {
        "definitionVersion": 1,
        "id": "part",
        "label": "part1",
        "parameters": {
          "attributes": "[{\"name\":\"position\",\"type\":\"vec3f\",\"semantic\":\"position\",\"default\":[0,0,0]}]",
          "capacity": 2000,
          "kernel": "fn process(p: Point, ctx: PointCtx) -> Point {\n  var q = p;\n  /* The E9 cursor push, as a stateless PROCESSOR: same §V182 pointer, same §V236\n     v-down mapping written where the clip convention is known, same Gaussian-not-edge. */\n  let cursor = vec3f(ctx.pointer.x * 2.0 - 1.0, 1.0 - ctx.pointer.y * 2.0, 0.0);\n  let away = q.position - cursor;\n  let distance = max(length(away), 0.0001);\n  let falloff = exp(-(distance * distance) / 0.16);\n  q.position = q.position + (away / distance) * falloff * 0.9;\n  return q;\n}",
          "seed": 31
        },
