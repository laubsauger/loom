        "definitionVersion": 1,
        "id": "atBrushed",
        "label": "atbrushed1",
        "parameters": {
          "attributes": "[{\"name\":\"position\",\"type\":\"vec3f\",\"semantic\":\"position\",\"default\":[0,0,0]}]",
          "capacity": 3072,
          "kernel": "\nfn process(p: Point, ctx: PointCtx) -> Point {\n  var q = p;\n  let u = (p.position.x * 0.5) + 0.5;\n  let v = (p.position.y * 0.5) + 0.5;\n  let theta = u * 6.2831853;\n  let phi = v * 3.14159265;\n  let r = 0.85;\n  q.position = vec3f(\n    -1.1 + (r * sin(phi) * cos(theta)),\n    0.95 + (r * cos(phi)),\n    r * sin(phi) * sin(theta),\n  );\n  return q;\n}\n",
          "seed": 69
        },
        "position": {
          "x": -1160,
          "y": 480
        },
        "type": "pointKernel"
      },
