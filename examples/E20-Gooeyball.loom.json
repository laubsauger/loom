      },
      "claim": {
        "definitionVersion": 1,
        "id": "claim",
        "label": "topology1",
        "parameters": {
          "cols": 64,
          "connectivity": "grid",
          "rows": 64,
          "wrapU": true,
          "wrapV": false
        },
