      "ball": {
        "definitionVersion": 1,
        "id": "ball",
        "label": "ball1",
        "parameters": {
          "attributes": "[{\"name\":\"position\",\"type\":\"vec3f\",\"semantic\":\"position\",\"default\":[0,0,0]}]",
          "capacity": 4096,
          "kernel": "fn process(p: Point, ctx: PointCtx) -> Point {\n  var q = p;\n  /* The grid is an INDEX SHEET; the sphere comes from the index, not the plane.\n     u runs col/COLS (not cols-1): column 0 and \"column COLS\" coincide, which is what\n     the wrapU seam cell downstream stitches together. v runs pole to pole. */\n  let col = f32(ctx.index % 64u);\n  let row = f32(ctx.index / 64u);\n  let u = col / 64.0;\n  let v = row / 63.0;\n  let theta = u * 6.28318530718;\n  let phi = v * 3.14159265359;\n  q.position = 0.85 * vec3f(sin(phi) * cos(theta), cos(phi), sin(phi) * sin(theta));\n  return q;\n}",
          "seed": 37
        },
        "position": {
          "x": -1180,
          "y": 0
        },
        "type": "pointKernel"
