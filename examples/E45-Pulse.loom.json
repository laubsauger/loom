      "hitsB": {
        "definitionVersion": 1,
        "id": "hitsB",
        "label": "hitsB1",
        "parameters": {
          "attributes": "[{\"name\":\"position\",\"type\":\"vec3f\",\"semantic\":\"position\",\"default\":[0,0,0]},{\"name\":\"tint\",\"type\":\"vec4f\",\"semantic\":\"color\",\"qualifier\":\"color\",\"default\":[1,1,1,1]},{\"name\":\"hitPosition\",\"type\":\"vec3f\",\"default\":[0,0,0]}]",
          "capacity": 180,
          "kernel": "fn process(p: Point, ctx: PointCtx) -> Point {\n  var q = p;\n  let slant = length(p.hitPosition - p.position);\n  let landed = select(0.0, 1.0, slant < 3.99);\n  let near = clamp(1.0 - slant / 4.0, 0.0, 1.0);\n  q.position = p.hitPosition + vec3f(0.0, 0.02, 0.0);\n  let ret = vec4f(1.0, 0.42 + 0.50 * near, 0.20, 1.0) * (0.4 + 1.8 * near);\n  q.tint = mix(vec4f(0.0), ret, landed);\n  return q;\n}"
        },
        "position": {
