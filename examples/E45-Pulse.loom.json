          "kernel": "fn process(p: Point, ctx: PointCtx) -> Point {\n  var q = p;\n  let slant = length(p.hitPosition - p.position);\n  let near = clamp(1.0 - slant / 4.0, 0.0, 1.0);\n  if (ctx.index % 6u != 0u) {\n    q.hitPosition = p.position;\n    q.tint = vec4f(0.0);\n    return q;\n  }\n  q.tint = vec4f(0.55, 0.75, 1.0, 1.0) * (0.30 + 0.85 * near);\n  return q;\n}"
